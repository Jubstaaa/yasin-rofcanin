---
import ShapeWave from '@/components/shape-wave.astro'
import { imageUrl } from '@/lib/image-url'
import Header from '@/components/header.astro'
import BaseLayout from '@/layouts/base-layout.astro'

import AboutMe from './_sections/about-me.astro'
import Publications from './_sections/publications.astro'
import Blog from './_sections/blog.astro'
import InvitedKeynoteTalks from './_sections/invited-keynote-talks.astro'
import EditoralRoles from './_sections/editoral-roles.astro'
import FutureOfWork from './_sections/future-of-work.astro'
import Teachings from './_sections/teachings.astro'
import Visitings from './_sections/visitings.astro'
---

<BaseLayout
    title="Yasin Rofcanin – Yasin Rofcanin Personal Homepage"
    description="Personal homepage of Yasin Rofcanin, Professor of Organisational Psychology and Human Resource Management at the University of Bath."
>
    <Header />
    <div class="relative mt-20 h-[600px] w-full overflow-hidden">
        <img
            src={imageUrl('hero.webp')}
            class="h-full w-full object-cover"
            alt=""
            width="1920"
            height="600"
            fetchpriority="high"
        />
        <div class="absolute right-0 bottom-0 p-3 text-end lg:p-12">
            <h1 class="font-secondary text-6xl text-[#f3f3f3] lg:text-8xl">Yasin Rofcanin</h1>
            <p class="text-[15px] font-bold text-[#f3f3f3] lg:text-2xl">
                Chair (Professor) in Organisational Psychology and Human Resource Management
                <br />
                <em>Co-Director of Future of Work Research (FoW) Centre</em>
                <br />
                <em>School of Management, University of Bath</em>
                <br />
                <em>Associate Editor of Human Relations</em>
                <br />
                <em>Associate Editor at Journal of Management Studies</em>
            </p>
        </div>
    </div>

    <main>
        <AboutMe />

        <Publications />
        <ShapeWave class="h-14 w-full fill-[#f3f3f3]" />

        <Blog />

        <InvitedKeynoteTalks />

        <EditoralRoles />
        <hr class="container mx-auto border-black" />

        <FutureOfWork />

        <Teachings />
        <ShapeWave class="h-14 w-full fill-[#f3f3f3]" />

        <Visitings />
    </main>
</BaseLayout>
