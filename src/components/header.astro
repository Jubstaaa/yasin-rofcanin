---
import { Icon } from 'astro-icon/components'

import { imageUrl } from '@/lib/image-url'

const menus = [
    { name: 'About Me', url: '#about-me' },
    { name: 'Publications', url: '#publications' },
    { name: 'Blog', url: '#blog' },
    { name: 'Invited Keynote Talks', url: '#invited-keynote-talks' },
    { name: 'Editoral Roles', url: '#editoral-roles' },
    { name: 'Future of Work', url: '#future-of-work' },
    { name: 'Teachings', url: '#teachings' },
    { name: 'Visitings', url: '#visitings' },
    { name: 'Media', url: '#media' },
    { name: 'Contact Me', url: '#contact-me' },
]
---

<div
    data-header
    class="fixed top-0 left-0 z-50 h-20 w-full bg-white shadow-md transition-transform duration-300 data-hidden:-translate-y-full"
>
    <header class="container mx-auto flex items-center justify-between px-4 py-2 lg:px-0">
        <img
            src={imageUrl('logo.webp')}
            class="h-14 w-auto"
            width="200"
            height="60"
            alt="Yasin Rofcanin Logo"
        />
        <nav aria-label="Main" class="hidden items-center justify-between gap-8 lg:flex">
            {menus.map(item => (
                <a
                    class="text-[13px] font-bold text-[#555555] transition-all hover:text-[#23a455]"
                    href={item.url}
                >
                    {item.name}
                </a>
            ))}
        </nav>
        <button
            type="button"
            class="cursor-pointer lg:hidden"
            aria-label="Open menu"
            aria-controls="mobile-drawer"
            aria-expanded="false"
            data-drawer-toggle
        >
            <Icon name="mdi:menu" class="size-10" aria-hidden="true" />
        </button>
    </header>
</div>

<div
    id="mobile-drawer"
    data-drawer
    inert
    class="fixed top-0 right-0 z-50 h-full w-64 translate-x-full bg-white shadow-lg transition-transform duration-300 ease-in-out data-open:translate-x-0 lg:hidden"
>
    <div class="p-4">
        <div class="flex justify-end">
            <button type="button" class="cursor-pointer" aria-label="Close menu" data-drawer-toggle>
                <Icon name="mdi:close" class="size-8" aria-hidden="true" />
            </button>
        </div>
        <nav aria-label="Mobile" class="mt-8 flex flex-col gap-4">
            {menus.map(item => (
                <a
                    class="text-[15px] font-bold text-[#555555] transition-all hover:text-[#23a455]"
                    href={item.url}
                    data-drawer-toggle
                >
                    {item.name}
                </a>
            ))}
        </nav>
    </div>
</div>

<div class="fixed inset-0 z-40 lg:hidden" hidden data-drawer-overlay data-drawer-toggle></div>

<script>
    const header = document.querySelector<HTMLElement>('[data-header]')
    const drawer = document.querySelector<HTMLElement>('[data-drawer]')
    const overlay = document.querySelector<HTMLElement>('[data-drawer-overlay]')
    const opener = document.querySelector<HTMLElement>('header [data-drawer-toggle]')

    const setDrawer = (open: boolean) => {
        if (!drawer || !overlay) return
        drawer.toggleAttribute('data-open', open)
        drawer.inert = !open
        overlay.hidden = !open
        opener?.setAttribute('aria-expanded', String(open))
    }

    for (const toggle of document.querySelectorAll('[data-drawer-toggle]')) {
        toggle.addEventListener('click', () => setDrawer(!drawer?.hasAttribute('data-open')))
    }
    document.addEventListener('keydown', event => {
        if (event.key === 'Escape') setDrawer(false)
    })

    let lastScrollY = 0
    window.addEventListener(
        'scroll',
        () => {
            const { scrollY } = window
            if (scrollY > lastScrollY) {
                if (scrollY > 200) header?.setAttribute('data-hidden', '')
            } else {
                header?.removeAttribute('data-hidden')
            }
            lastScrollY = scrollY
        },
        { passive: true },
    )
</script>
