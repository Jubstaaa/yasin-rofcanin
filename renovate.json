{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>Jubstaaa/configs",
        "github>Jubstaaa/configs:cooldown"
    ],
    "packageRules": [
        {
            "matchPackageNames": [
                "astro",
                "@astrojs/**",
                "astro-icon"
            ],
            "groupName": "astro"
        },
        {
            "matchPackageNames": [
                "prettier",
                "prettier-plugin-*"
            ],
            "groupName": "prettier"
        },
        {
            "matchPackageNames": [
                "@iconify-json/**"
            ],
            "groupName": "iconify"
        }
    ]
}
